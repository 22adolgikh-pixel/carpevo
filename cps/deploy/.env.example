# Скопировать в .env рядом с docker-compose.yml на VPS и заполнить.
# Файл .env НЕ коммитить в git (он уже в .gitignore).

# Fine-grained токен GitHub, Contents: Read and write на репозиторий carpevo.
# Тот же, что уже используется в ~/Desktop/cps/.env на Mac — можно скопировать его.
CPS_GITHUB_TOKEN=

# id zip-архива сканов на Google Drive (папка carpet-dna/cps_scans, доступ
# "у кого есть ссылка" -> Читатель). Уже залит 2026-09-28, менять не нужно,
# если только не перезаливаете сканы заново под другим файлом.
CPS_SCANS_ZIP_ID=1OnOEzpshgYbAOO0spUKElXYQXG1aolen

# Пароль входа в студию. ОБЯЗАТЕЛЬНО задать — иначе студия открыта всем,
# у кого есть адрес/IP VPS.
CPS_PASSWORD=

# Как часто пушить правки в GitHub (минуты). На VPS диск постоянный (не как на
# Render), так что 10 тоже безопасно, но 2-3 меньше рискует потерей правок
# при падении контейнера/сервера.
CPS_BACKUP_MIN=3
